{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vscode"],
    "outDir": "./out",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", ".vscode-test"]
}
